<div class="max-w-3xl mx-auto mt-8 bg-zinc-800 rounded-2xl shadow-xl overflow-hidden border border-zinc-700">

  <!-- Header -->
  <header class="bg-zinc-800 px-6 py-4 border-b border-zinc-700 flex items-center gap-3">
    <div class="bg-gradient-to-br from-blue-400 to-blue-700 text-white w-12 h-12 rounded-full flex items-center justify-center shadow-sm overflow-hidden">
      <img src="/nyc_street.png" class="w-full h-full object-cover" alt="nyc street">
    </div>
    <h2 class="m-0 text-xl font-semibold text-zinc-100">Image Generator</h2>
    <%= link_to "← Back to Chat", chats_path, class: "ml-auto text-sm text-zinc-300 hover:text-zinc-100" %>
  </header>

  <div class="p-8 bg-zinc-900">
    <% if flash[:error] %>
      <div class="mb-6 px-4 py-3 bg-red-900/40 border border-red-700 text-red-400 rounded-lg text-sm">
        <%= flash[:error] %>
      </div>
    <% end %>

    <!-- Ask AI to craft the prompt -->
    <div class="mb-6 bg-zinc-800 border border-zinc-700 rounded-xl p-5">
      <p class="text-zinc-300 text-sm font-semibold mb-3">Ask AI to write the prompt for you</p>

      <div class="flex gap-2 mb-3" id="ai-model-toggle">
        <button type="button" data-provider="claude"
          class="ai-model-btn px-4 py-1.5 rounded-full text-sm font-medium border border-zinc-500 text-zinc-300 hover:text-zinc-100 hover:border-zinc-300 transition-colors selected-model">
          Claude
        </button>
        <button type="button" data-provider="gemini"
          class="ai-model-btn px-4 py-1.5 rounded-full text-sm font-medium border border-zinc-600 text-zinc-400 hover:text-zinc-100 hover:border-zinc-300 transition-colors">
          Gemini
        </button>
      </div>

      <div class="flex gap-3">
        <input type="text" id="ai-description"
          placeholder="e.g. a fox in a neon-lit Tokyo alley at night"
          class="flex-1 bg-zinc-700 border border-zinc-600 rounded-xl px-4 py-2.5 text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-400 text-sm" />
        <button type="button" id="ask-ai-btn"
          class="nyc-bg text-white font-semibold px-5 py-2.5 rounded-full text-sm transition-colors cursor-pointer whitespace-nowrap">
          Ask AI
        </button>
      </div>

      <p id="ai-status" class="mt-2 text-xs text-zinc-500 hidden"></p>
    </div>

    <p class="text-zinc-400 text-sm mb-4">Or write your own Stable Diffusion prompt below.</p>

    <%= form_with url: images_path, local: true, data: { turbo: false } do |f| %>
      <div class="flex flex-col gap-4">
        <%= f.text_area :prompt,
              id: "sd-prompt",
              placeholder: "A cat riding a bicycle through the streets of New York City...",
              rows: 4,
              class: "w-full bg-zinc-700 border border-zinc-600 rounded-xl px-4 py-3 text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-400 focus:border-zinc-400 resize-none",
              required: true,
              autofocus: true %>

        <%= f.submit "Generate & Download",
              class: "self-end nyc-bg text-white font-semibold px-6 py-3 rounded-full transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <% if @image_data %>
      <div class="mt-6">
        <img src="data:image/png;base64,<%= @image_data %>" class="w-full rounded-xl shadow-md" alt="<%= @prompt %>" />
        <a href="data:image/png;base64,<%= @image_data %>" download="<%= @filename %>" class="mt-3 inline-block text-sm text-zinc-300 hover:text-zinc-100">Download image</a>
      </div>
    <% end %>
  </div>
</div>

<script>
  (() => {
    const toggle   = document.getElementById('ai-model-toggle');
    const askBtn   = document.getElementById('ask-ai-btn');
    const descInput = document.getElementById('ai-description');
    const sdPrompt = document.getElementById('sd-prompt');
    const status   = document.getElementById('ai-status');
    let selectedProvider = 'claude';

    // Model toggle
    toggle.querySelectorAll('.ai-model-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedProvider = btn.dataset.provider;
        toggle.querySelectorAll('.ai-model-btn').forEach(b => {
          b.classList.toggle('selected-model', b === btn);
          b.classList.toggle('border-zinc-300', b === btn);
          b.classList.toggle('text-zinc-100', b === btn);
          b.classList.toggle('border-zinc-600', b !== btn);
          b.classList.toggle('text-zinc-400', b !== btn);
        });
      });
    });

    // Ask AI
    askBtn.addEventListener('click', async () => {
      const description = descInput.value.trim();
      if (!description) return;

      askBtn.disabled = true;
      askBtn.textContent = 'Thinking…';
      status.textContent = `Asking ${selectedProvider === 'claude' ? 'Claude' : 'Gemini'} to craft your prompt…`;
      status.classList.remove('hidden');

      try {
        const resp = await fetch('<%= ai_prompt_images_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({ description, provider: selectedProvider })
        });

        const data = await resp.json();

        if (data.prompt) {
          sdPrompt.value = data.prompt;
          sdPrompt.focus();
          status.textContent = 'Prompt ready — review it below and click Generate.';
        } else {
          status.textContent = `Error: ${data.error || 'Something went wrong'}`;
        }
      } catch (e) {
        status.textContent = `Network error: ${e.message}`;
      } finally {
        askBtn.disabled = false;
        askBtn.textContent = 'Ask AI';
      }
    });

    // Allow Enter key in description field
    descInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); askBtn.click(); }
    });
  })();
</script>
