<div class="flex gap-4 w-full h-[92vh]">

  <!-- Sidebar: Conversation List -->
  <div class="w-56 flex-shrink-0 bg-zinc-800 rounded-2xl shadow-xl flex flex-col overflow-hidden border border-zinc-700">
    <div class="p-3 border-b border-zinc-700">
      <%= button_to conversations_path, method: :post,
            class: "w-full nyc-bg text-white text-sm font-medium rounded-xl px-3 py-2 transition-colors" do %>
        + New Chat
      <% end %>
    </div>

    <div class="flex-grow overflow-y-auto p-2 flex flex-col gap-1">
      <% @conversations.each do |conv| %>
        <% active = conv.id == @conversation.id %>
        <div class="group flex items-center gap-1">
          <%= link_to chats_path(conversation_id: conv.id),
                class: "flex-grow min-w-0 px-3 py-2 rounded-xl text-sm transition-colors #{active ? 'bg-zinc-700 text-zinc-100 font-medium' : 'text-zinc-400 hover:bg-zinc-700 hover:text-zinc-100'}" do %>
            <div class="truncate"><%= conv.title.present? ? conv.title : "New conversation" %></div>
            <div class="text-xs text-zinc-500 mt-0.5"><%= conv.created_at.strftime("%b %-d") %></div>
          <% end %>
          <%= button_to conversation_path(conv), method: :delete,
                class: "delete-btn opacity-0 group-hover:opacity-100 flex-shrink-0 w-8 h-8 rounded-full border-2 border-zinc-500 relative transition-all hover:border-red-500",
                data: { confirm: "Delete this conversation?" } do %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Main Chat Panel -->
  <div class="flex-grow bg-zinc-800 rounded-2xl shadow-xl flex flex-col overflow-hidden border border-zinc-700">

    <!-- Header -->
    <header class="chat-header-bg px-6 py-4 border-b border-zinc-700 flex items-center flex-wrap gap-3 ">
      <h2 class="m-0 text-lg font-semibold text-white truncate drop-shadow">
        <%= @conversation.title.present? ? @conversation.title : "New conversation" %>
      </h2>
      <!-- AI Model Toggle -->
      <div class="ml-auto flex flex-col items-end gap-2">
        <div class="flex items-center gap-1 bg-black/30 rounded-full p-1 border border-white/20">
          <%= button_to session_path, method: :patch,
                params: { ai_model: 'gemini' },
                class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{@ai_model == 'gemini' ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
            Gemini
          <% end %>
          <%= button_to session_path, method: :patch,
                params: { ai_model: 'claude' },
                class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{@ai_model == 'claude' ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
            Claude
          <% end %>
          <%= button_to session_path, method: :patch,
                params: { ai_model: 'ollama' },
                class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{@ai_model == 'ollama' ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
            Ollama
          <% end %>
        </div>
        <% if @ai_model == 'claude' %>
          <div class="flex items-center gap-1 bg-black/30 rounded-full p-1 border border-white/20">
            <%= button_to session_path, method: :patch,
                  params: { claude_model: 'sonnet' },
                  class: "px-3 py-1 rounded-full text-xs font-medium transition-colors #{@claude_model == 'sonnet' ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
              Sonnet
            <% end %>
            <%= button_to session_path, method: :patch,
                  params: { claude_model: 'opus' },
                  class: "px-3 py-1 rounded-full text-xs font-medium transition-colors #{@claude_model == 'opus' ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
              Opus
            <% end %>
          </div>
        <% elsif @ai_model == 'gemini' %>
          <div class="flex items-center gap-1 bg-black/30 rounded-full p-1 border border-white/20">
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/20 text-white shadow-sm">Flash</span>
          </div>
        <% elsif @ai_model == 'ollama' && @ollama_models.any? %>
          <div class="flex items-center gap-1 bg-black/30 rounded-full p-1 border border-white/20 max-w-xs overflow-x-auto">
            <% @ollama_models.each do |model| %>
              <%= button_to session_path, method: :patch,
                    params: { ollama_model: model },
                    class: "px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors #{@ollama_model == model ? 'bg-white/20 text-white shadow-sm' : 'text-white/50 hover:text-white'}" do %>
                <%= model %>
              <% end %>
            <% end %>
          </div>
        <% elsif @ai_model == 'ollama' %>
          <div class="flex items-center gap-1 bg-black/30 rounded-full p-1 border border-white/20">
            <span class="px-3 py-1 rounded-full text-xs font-medium text-red-400">No models found</span>
          </div>
        <% end %>
      </div>
    </header>

    <!-- Chat History -->
    <div class="flex-grow p-6 overflow-y-auto bg-zinc-900 flex flex-col gap-5" id="chat-messages">
      <% if @messages.empty? %>
        <div class="text-center text-zinc-500 mt-10">
          <p>Send a message to start the conversation!</p>
        </div>
      <% end %>

      <% @messages.each do |msg| %>
        <div class="flex items-end gap-2 w-full <%= msg.role == 'user' ? 'justify-end' : 'justify-start' %>">

          <% if msg.role == 'model' %>
            <div class="w-8 h-8 rounded-full flex-shrink-0 overflow-hidden shadow-sm">
              <img src="/nyc_skyline.png" class="w-full h-full object-cover" alt="nyc">
            </div>
          <% end %>

          <% if msg.image_data.present? %>
            <div class="max-w-[70%] flex flex-col gap-2">
              <img src="data:image/png;base64,<%= msg.image_data %>" class="rounded-2xl shadow-md w-full" alt="generated image" />
              <a href="data:image/png;base64,<%= msg.image_data %>"
                 download="image_<%= msg.id %>.png"
                 class="text-xs text-zinc-400 hover:text-zinc-200 text-center">
                Download
              </a>
            </div>
          <% else %>
            <div class="max-w-[80%] px-4 py-3 text-[15px] leading-relaxed <%= msg.role == 'user' ? 'bg-black text-white rounded-2xl rounded-br-sm shadow-md' : 'bg-zinc-700 text-zinc-100 rounded-2xl rounded-bl-sm border border-zinc-600 shadow-sm prose-chat' %>">
              <% if msg.role == 'user' %>
                <%= simple_format(msg.content) %>
              <% else %>
                <%= render_markdown(msg.content) %>
              <% end %>
            </div>
          <% end %>

        </div>
      <% end %>
    </div>

    <!-- Input Form -->
    <div class="p-4 bg-zinc-800 border-t border-zinc-700">
      <%= form_with url: chats_path, local: true, id: "chat-form", class: "flex gap-2 items-end bg-zinc-700 border border-zinc-600 rounded-2xl p-1.5 focus-within:ring-2 focus-within:ring-zinc-400 focus-within:border-zinc-400 transition-all" do |f| %>

        <%
          placeholder_name = case @ai_model
          when 'claude' then @claude_model.capitalize
          when 'ollama' then (@ollama_model || "Ollama")
          else @gemini_model.capitalize
          end
        %>
        <%= f.text_area :content,
                        placeholder: "Message #{placeholder_name}... (ask it to generate an image!)",
                        class: "flex-grow bg-transparent border-none focus:ring-0 text-zinc-100 placeholder-zinc-400 px-4 py-2 outline-none resize-none overflow-hidden",
                        required: true,
                        autocomplete: 'off',
                        autofocus: true,
                        rows: 1,
                        id: "message-input" %>

        <%= button_tag type: 'submit', class: "rounded-full w-10 h-10 flex items-center justify-center flex-shrink-0 mb-0.5 overflow-hidden border-2 border-zinc-500 hover:border-zinc-200 active:border-white active:scale-95 transition-all duration-150 cursor-pointer" do %>
          <img src="/bike_wheel.png" class="w-full h-full object-cover" alt="send">
        <% end %>
      <% end %>
    </div>

  </div>
</div>

<!-- Auto-Scroll & Textarea JavaScript -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const chatMessages = document.getElementById("chat-messages");
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    const input = document.getElementById("message-input");
    if (input) {
      input.addEventListener("input", function() {
        this.style.height = "auto";
        this.style.height = this.scrollHeight + "px";
      });
    }
  });
</script>
