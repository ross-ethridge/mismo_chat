<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mismo Chat" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mismo Chat">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      .nyc-bg {
        background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url('/nyc_bg.png');
        background-size: cover;
        background-position: center;
        color: white !important;
      }
      .nyc-bg:hover { opacity: 0.85; }
      .chat-header-bg {
        background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.5)), url('/chat_header.png');
        background-size: cover;
        background-position: center center;
        color: white !important;
        min-height: 200px;
      }
      .delete-btn::after {
        content: '';
        position: absolute;
        top: 50%; left: 50%;
        width: 130%; height: 2px;
        background: #71717a;
        transform: translate(-50%, -50%) rotate(-45deg);
        border-radius: 1px;
      }
      .delete-btn:hover::after { background: #ef4444; }
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-900">
    <main class="container mx-auto mt-6 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
